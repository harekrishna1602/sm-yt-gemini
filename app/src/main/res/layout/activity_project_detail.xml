<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_pill_surface"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnDeleteIdea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Delete"
            android:textColor="#FF453A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Phase 1: Mobile Gemini Content Creation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOBILE GEMINI BRIDGE (ZERO API KEY)"
                android:textColor="#8E96A4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtVideoLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="Paste unlisted YouTube link (optional)"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6470"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSendVideoToGemini"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E293B"
                    android:text="Video → Gemini"
                    android:textAllCaps="false"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSendLinkToGemini"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0A84FF"
                    android:text="Package in Gemini"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSmartPasteGemini"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#34C759"
                android:text="Smart Paste from Mobile Gemini"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Phase 2: Thumbnail Integration (YT Studio Gemini + Mobile Gemini) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="THUMBNAIL STUDIO (YT STUDIO + GEMINI)"
                android:textColor="#8E96A4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgThumbnailPreview"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:contentDescription="Video Thumbnail"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnThumbYtStudio"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FF3B30"
                    android:text="YT Studio Thumb"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnThumbGemini"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#7C3AED"
                    android:text="Gemini Thumb"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPickThumbGallery"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1E293B"
                android:text="Attach Saved Thumbnail from Gallery"
                android:textAllCaps="false"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CORE VIDEO ANGLE"
                android:textColor="#8E96A4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAngle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:hint="What is the 1-sentence hook or angle?"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6470"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VOICE-TO-SCRIPT"
                    android:textColor="#8E96A4"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnVoiceScript"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#34C759"
                    android:text="Voice Dictate"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/edtScript"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="Tap Voice Dictate and speak naturally, or type your script beats..."
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6470"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnHookInGemini"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0A84FF"
                android:text="Tighten 15s Hook in Mobile Gemini"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="PACKAGING &amp; SEO METADATA"
                android:textColor="#8E96A4"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_field"
                android:hint="Final YouTube Title (&lt;55 chars)"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6470"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTitleGuard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtThumbText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:hint="Thumbnail Text (max 4 words, no repeats)"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6470"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtThumbGuard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="YouTube Description (auto-filled via Smart Paste)"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6470"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:hint="YouTube Tags (comma-separated)"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5C6470"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveIdea"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#FF3B30"
                android:text="Save Progress"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPublishIdea"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1E293B"
                android:text="Mark as Published"
                android:textAllCaps="false"
                android:textColor="#34C759"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
